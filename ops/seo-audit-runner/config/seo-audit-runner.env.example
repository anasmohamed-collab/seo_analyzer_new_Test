# ═══════════════════════════════════════════════════════════════════
#  seo-audit-runner — production configuration template
#
#  install.sh copies this file to /etc/seo-audit-runner/runner.env
#  ONLY when that file does not exist yet (an existing runner.env is
#  never overwritten). Target permissions: root:seo-runner 0640.
#
#  This template contains NO real credentials — fill in the Slack
#  values on the host, never in the repository.
#
#  SECURITY: repository code does not authenticate the runner. Production
#  requires a PRIVATE endpoint plus IT-owned workload authentication; private
#  routing alone is not authentication. App and sidecar egress enforcement is
#  also mandatory.
# ═══════════════════════════════════════════════════════════════════

# Base URL of the running SEO analyzer app (origin only, no path).
SEO_API_BASE_URL=http://127.0.0.1:3000

# Max audits running in parallel across DIFFERENT sites. Start at 1. Same-site
# DB-mode runs are protected by the application's per-project advisory lock.
RUNNER_CONCURRENCY=1

# Eligibility is checked before dedupe and before any audit POST. Empty include
# means all otherwise-eligible projects; explicit exclusions always win.
# RUNNER_EXCLUDE_NONPRODUCTION matches EXACT hostname labels: beta, new, next,
# staging, stage, dev, development, test, testing, preview, demo, sandbox, qa,
# uat. Substrings never match (newtimes.co.rw stays eligible), and a project
# with a persisted is_beta=true is exempt.
RUNNER_INCLUDE_PROJECT_IDS=
RUNNER_EXCLUDE_PROJECT_IDS=
RUNNER_EXCLUDE_NONPRODUCTION=true
RUNNER_REQUIRE_STORED_CONFIG=true

# Maximum queued jobs attempted by one five-minute tick. Use 1 for the
# controlled TEST pilot; 6 is the conservative steady-state default.
RUNNER_MAX_JOBS_PER_TICK=6

# Polling cadence, per-audit timeout, and per-request HTTP timeout.
POLL_INTERVAL_MS=5000
POLL_TIMEOUT_MS=900000
HTTP_REQUEST_TIMEOUT_MS=30000

# Runner-owned durable state (SQLite database, run journals, backups).
# These are the approved production paths — the runner writes nowhere else.
RUNNER_STATE_DIR=/var/lib/seo-audit-runner
RUNNER_STATE_DB_PATH=/var/lib/seo-audit-runner/runner-state.sqlite

# error | warn | info | debug
RUNNER_LOG_LEVEL=info

# ── Notifications ───────────────────────────────────────────────────
# Master switch. NOTE: the template ships with notifications DISABLED
# because enabling them requires a configured Slack delivery method
# below — `seo-audit-runner validate-config` fails otherwise. Set
# NOTIFICATIONS_ENABLED=true after filling in the Slack values.
NOTIFICATIONS_ENABLED=false

# Alert mode: new_or_regressed | all_current | summary_only | disabled
SEO_RUNNER_ALERT_MODE=new_or_regressed

# Send one end-of-execution summary message per run.
SEO_RUNNER_SEND_RUN_SUMMARY=true

# ── Slack delivery (leave empty in the repo; fill in on the host) ───
# Preferred method: bot token + channel ID (both required; the bot needs
# the chat:write scope and must be invited to the channel).
#
# The intended alert channel is #seo_analyzer_bot. Put its IMMUTABLE CHANNEL ID
# here (starts with C…), never the channel name — the runner posts to the ID and
# performs no channel-name lookup and no Slack discovery call.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Fallback method: incoming webhook (used only when no bot token is set).
SLACK_WEBHOOK_URL=

# Broad channel mention on CRITICAL alerts. Default: none.
#   none (default)  — no broad mention on any message
#   channel         — OPT-IN: one <!channel> (@channel) on a PRODUCTION critical
#                     alert that reports a NEW or REOPENED P0
#   here | everyone — accepted, then neutralized to `none`; never activated
#   anything else   — fails validate-config
#
# With `channel`, the mention still requires ALL of: a project-level critical
# alert, a Production project (is_beta !== true), at least one notification-
# eligible NEW or REOPENED P0, and notifications/alert mode already permitting
# the send. Beta exposure alerts, UNCHANGED-only and RESOLVED-only alerts, run
# summaries, failures, timeouts, incomplete evidence and skipped/deferred
# projects NEVER carry a mention. A message with NEW/REOPENED P0 plus other
# buckets mentions the channel exactly once.
#
# Enabling this is a deliberate operator action. Audit-controlled text can never
# inject a mention, and payloads queued in SQLite without explicit authorization
# are stripped at delivery time.
SLACK_CRITICAL_MENTION=none

# Slack reliability and formatting limits.
SLACK_REQUEST_TIMEOUT_MS=15000
SLACK_MAX_RETRIES=4
# The critical-alert format caps visible issues at 5; a lower value still wins.
SLACK_MAX_ISSUES_PER_MESSAGE=20
SLACK_MAX_MESSAGE_CHARACTERS=30000
