# seo-runner-tick.service — one scheduler tick (`worker --once`).
#
# THE ONLY production unit of this runner. It is started exclusively by
# seo-runner-tick.timer, and that timer is the SINGLE scheduling authority
# for the whole automation: no second timer, no second service, and no
# cron entry may drive this runner on the same host (deploy/cron.example
# is documentation for systemd-less hosts and is mutually exclusive with
# systemd). SHIPS DISABLED — enabling is an explicit administrator action
# gated by docs/PRODUCTION_GATES.md.
#
# The tick model: systemd only starts the worker; the runner decides what
# is due from its OWN state database (schedules + job queue managed via
# `seo-audit-runner schedule|job ...`). One tick owns, in this order:
#   1. crash recovery     — RUNNING jobs whose worker is gone -> FAILED;
#   2. stale executions   — a claim that was abandoned is reclaimed, and an
#                           outcome from a stale execution is never recorded
#                           over the current owner's;
#   3. due schedules      — one occurrence creates AT MOST one job (unique
#                           (schedule_id, occurrence_key) index);
#   4. queued jobs        — claimed atomically, executed sequentially; the
#                           child takes the runner's process lock, so a tick
#                           can never overlap a manual run (the child exits
#                           4 and the job returns to QUEUED);
#   5. notification retry — queued/failed Slack deliveries are retried at
#                           the end of the tick; a failure there never fails
#                           the tick or the audits in it.
# Because the tick owns all five, no separate retry timer exists.
[Unit]
Description=SEO audit runner — scheduler tick (runner-managed schedules)
Documentation=file:/opt/seo-audit-runner/current/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=seo-runner
Group=seo-runner
EnvironmentFile=/etc/seo-audit-runner/runner.env
ExecStart=/usr/local/bin/seo-audit-runner worker --once
Nice=10

TimeoutStartSec=2h
KillSignal=SIGTERM
TimeoutStopSec=90

MemoryHigh=1G
MemoryMax=2G
TasksMax=128

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/seo-audit-runner /var/log/seo-audit-runner
RuntimeDirectory=seo-audit-runner
RuntimeDirectoryMode=0750
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0027
